      ],
      "operations": [
        {
          "id": "create_subscription",
          "effect": "command",
          "contractRef": "https://docs.stripe.com/api/subscriptions/create",
          "requestMappings": [
            {"source": "providerPlanRef", "targetPointer": "/items/0/price", "transform": "registry-lookup"},
            {"source": "tenantRef", "targetPointer": "/metadata/tenant_ref", "transform": "opaque-reference"}
