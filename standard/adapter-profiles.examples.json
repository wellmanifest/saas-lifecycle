          "effect": "query",
          "contractRef": "https://docs.stripe.com/api/subscriptions/retrieve",
          "requestMappings": [
            {"source": "providerResourceId", "targetPointer": "/id", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/id", "target": "billingRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/items/data/0/price/id", "target": "providerPlanRef", "transform": "identity"},
            {"sourceKind": "provider-response", "sourcePointer": "/metadata/tenant_ref", "target": "tenantRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"},
            {"sourceKind": "provider-plan-registry", "sourcePointer": "/planRef", "target": "planRef", "transform": "registry-lookup"},
            {"sourceKind": "provider-plan-registry", "sourcePointer": "/priceRef", "target": "priceRef", "transform": "registry-lookup"},
            {"sourceKind": "provider-response", "sourcePointer": "/items/data/0/price/unit_amount", "target": "amountMinor", "transform": "identity"},
            {"sourceKind": "provider-response", "sourcePointer": "/currency", "target": "currency", "transform": "uppercase"},
            {"sourceKind": "request-ledger", "sourcePointer": "/accountRef", "target": "accountRef", "transform": "identity"}
          ],
          "idempotency": {"required": false, "keySource": "none"}
        },
        {
          "id": "cancel_subscription",
          "effect": "command",
          "contractRef": "https://docs.stripe.com/api/subscriptions/cancel",
          "requestMappings": [
            {"source": "providerResourceId", "targetPointer": "/id", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/id", "target": "billingRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
          "idempotency": {"required": true, "keySource": "request-id"}
        },
        {
          "id": "create_payment",
          "effect": "command",
          "contractRef": "https://docs.stripe.com/api/payment_intents/create",
          "requestMappings": [
            {"source": "amountMinor", "targetPointer": "/amount", "transform": "identity"},
            {"source": "currency", "targetPointer": "/currency", "transform": "lowercase"},
            {"source": "tenantRef", "targetPointer": "/metadata/tenant_ref", "transform": "opaque-reference"},
            {"source": "priceRef", "targetPointer": "/metadata/price_ref", "transform": "opaque-reference"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/id", "target": "billingRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
          "idempotency": {"required": true, "keySource": "request-id"}
        },
        {
          "id": "inspect_payment",
          "effect": "query",
          "contractRef": "https://docs.stripe.com/api/payment_intents/retrieve",
          "requestMappings": [
            {"source": "providerResourceId", "targetPointer": "/id", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/id", "target": "billingRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/metadata/tenant_ref", "target": "tenantRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/metadata/price_ref", "target": "priceRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/amount", "target": "amountMinor", "transform": "identity"},
            {"sourceKind": "provider-response", "sourcePointer": "/currency", "target": "currency", "transform": "uppercase"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"},
            {"sourceKind": "request-ledger", "sourcePointer": "/accountRef", "target": "accountRef", "transform": "identity"},
            {"sourceKind": "request-ledger", "sourcePointer": "/planRef", "target": "planRef", "transform": "identity"}
          ],
          "idempotency": {"required": false, "keySource": "none"}
        },
        {
          "id": "capture_payment",
          "effect": "command",
          "contractRef": "https://docs.stripe.com/api/payment_intents/capture",
          "requestMappings": [
