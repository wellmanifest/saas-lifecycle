          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/id", "target": "billingRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
