    {
      "$schema": "https://wellmanifest.dev/schemas/saas-adapter-profile/v1",
      "schema": "wellmanifest.saas-deployment-adapter-profile/v1",
      "profileRef": "profile://sub.actor/deployment/plesk-wellmanifest/v1",
      "version": "1.0.0",
      "adapterRef": "adapter://sub.actor/deployment/plesk-wellmanifest/v1",
      "upstreamContracts": [
        "contract://wellmanifest.dev/poa/deployment/v1",
        "contract://wellmanifest.dev/deployment/grants/v1",
        "https://docs.plesk.com/en-US/obsidian/api-rpc/about-xml-api.28709/",
        "plesk://host/site/command/publish",
        "plesk://host/site/command/publish-verify",
        "plesk://host/site/command/release-rollback"
      ],
      "operations": [
        {
          "id": "compile",
          "effect": "query",
          "contractRef": "contract://wellmanifest.dev/poa/deployment/v1#compile",
          "requestMappings": [
            {"source": "accountRef", "targetPointer": "/accountRef", "transform": "identity"},
            {"source": "tenantRef", "targetPointer": "/tenantRef", "transform": "identity"},
            {"source": "planRef", "targetPointer": "/planRef", "transform": "identity"},
            {"source": "deploymentRef", "targetPointer": "/deploymentRef", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/planHash", "target": "planHash", "transform": "identity"},
            {"sourceKind": "provider-response", "sourcePointer": "/deploymentRef", "target": "deploymentRef", "transform": "identity"}
          ],
          "idempotency": {"required": false, "keySource": "none"}
        },
        {
          "id": "authorize",
          "effect": "command",
          "contractRef": "contract://wellmanifest.dev/deployment/grants/v1#issue-single-use",
          "requestMappings": [
            {"source": "deploymentRef", "targetPointer": "/deploymentRef", "transform": "identity"},
            {"source": "planHash", "targetPointer": "/planHash", "transform": "identity"},
            {"source": "idempotencyKey", "targetPointer": "/idempotencyKey", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/grantRef", "target": "grantRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/evidenceRef", "target": "evidenceRef", "transform": "opaque-reference"}
          ],
          "idempotency": {"required": true, "keySource": "outbox-id"}
        },
        {
          "id": "apply",
          "effect": "command",
          "contractRef": "plesk://host/site/command/publish",
          "requestMappings": [
            {"source": "deploymentRef", "targetPointer": "/deploymentRef", "transform": "identity"},
            {"source": "planHash", "targetPointer": "/planHash", "transform": "identity"},
            {"source": "grantRef", "targetPointer": "/grantRef", "transform": "identity"},
            {"source": "idempotencyKey", "targetPointer": "/idempotencyKey", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "provider-response", "sourcePointer": "/deploymentRef", "target": "deploymentRef", "transform": "identity"},
            {"sourceKind": "provider-response", "sourcePointer": "/evidenceRef", "target": "evidenceRef", "transform": "opaque-reference"},
            {"sourceKind": "provider-response", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
          "idempotency": {"required": true, "keySource": "outbox-id"}
        },
        {
          "id": "verify",
          "effect": "verification",
          "contractRef": "plesk://host/site/command/publish-verify",
          "requestMappings": [
            {"source": "deploymentRef", "targetPointer": "/deploymentRef", "transform": "identity"},
            {"source": "planHash", "targetPointer": "/planHash", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "deployment-verifier", "sourcePointer": "/resourceRef", "target": "resourceRef", "transform": "opaque-reference"},
            {"sourceKind": "deployment-verifier", "sourcePointer": "/evidenceRef", "target": "evidenceRef", "transform": "opaque-reference"},
            {"sourceKind": "deployment-verifier", "sourcePointer": "/planHash", "target": "planHash", "transform": "identity"},
            {"sourceKind": "deployment-verifier", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
          "idempotency": {"required": true, "keySource": "outbox-id"}
        },
        {
          "id": "rollback",
          "effect": "command",
          "contractRef": "plesk://host/site/command/release-rollback",
          "requestMappings": [
            {"source": "deploymentRef", "targetPointer": "/deploymentRef", "transform": "identity"},
            {"source": "grantRef", "targetPointer": "/grantRef", "transform": "identity"},
            {"source": "idempotencyKey", "targetPointer": "/idempotencyKey", "transform": "identity"}
          ],
          "evidenceMappings": [
            {"sourceKind": "deployment-verifier", "sourcePointer": "/resourceRef", "target": "resourceRef", "transform": "opaque-reference"},
            {"sourceKind": "deployment-verifier", "sourcePointer": "/evidenceRef", "target": "evidenceRef", "transform": "opaque-reference"},
            {"sourceKind": "deployment-verifier", "sourcePointer": "/status", "target": "providerStatus", "transform": "identity"}
          ],
          "idempotency": {"required": true, "keySource": "outbox-id"}
        }
      ],
      "requiredBindings": ["accountRef", "tenantRef", "planRef", "deploymentRef", "planHash", "grantRef", "idempotencyKey"],
      "authorization": {
        "mode": "single-use-external-grant",
        "operationId": "authorize",
        "persistGrant": false,
        "denialOutcome": "denied"
      },
      "activationBoundary": {
        "requiresApplyAndVerify": true,
        "verifyOperationId": "verify",
        "successOutcome": "activated",
        "mismatchOutcome": "failed"
      },
      "outbox": {
        "durable": true,
        "reuseIdempotencyKey": true,
        "claimMode": "single-worker-lease"
      },
      "coordinatePolicy": {
        "profileContainsCoordinates": false,
        "resolution": "external-deployment-binding",
        "receipt": "resource-reference-only"
      },
      "retryPolicy": {
        "maxAttempts": 5,
        "backoff": "bounded-exponential",
        "retryableOutcomes": ["timeout", "rate-limited", "provider-unavailable", "pending"],
        "terminalOutcomes": ["verified", "denied", "failed", "cancelled", "exhausted"]
      },
      "evidencePolicy": {
        "providerPayload": "separate-evidence-store",
        "lifecycleReceipt": "references-and-digests-only",
        "authorizationMaterial": "external-binding-only",
        "personalData": "minimized"
      }
    }
  ]
}
