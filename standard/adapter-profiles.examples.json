        },
        {
          "id": "verify_event",
          "effect": "verification",
          "contractRef": "https://docs.stripe.com/webhooks/signature",
          "requestMappings": [],
          "evidenceMappings": [
            {"sourceKind": "verified-event", "sourcePointer": "/id", "target": "eventRef", "transform": "opaque-reference"},
            {"sourceKind": "verified-event", "sourcePointer": "/type", "target": "eventType", "transform": "identity"},
            {"sourceKind": "verified-event", "sourcePointer": "/created", "target": "occurredAt", "transform": "unix-seconds-to-date-time"}
          ],
          "idempotency": {"required": true, "keySource": "event-id"}
        }
      ],
      "requiredBindings": ["accountRef", "tenantRef", "planRef", "priceRef", "amountMinor", "currency", "providerStatus"],
      "eventBindings": [
        {"providerEvent": "customer.subscription.created", "lifecycleSignal": "reconcile_subscription", "eventIdPointer": "/id", "resourcePointer": "/data/object/id", "requiresInspection": true},
        {"providerEvent": "customer.subscription.updated", "lifecycleSignal": "reconcile_subscription", "eventIdPointer": "/id", "resourcePointer": "/data/object/id", "requiresInspection": true},
        {"providerEvent": "customer.subscription.deleted", "lifecycleSignal": "reconcile_subscription", "eventIdPointer": "/id", "resourcePointer": "/data/object/id", "requiresInspection": true},
        {"providerEvent": "payment_intent.succeeded", "lifecycleSignal": "reconcile_payment", "eventIdPointer": "/id", "resourcePointer": "/data/object/id", "requiresInspection": true},
        {"providerEvent": "payment_intent.payment_failed", "lifecycleSignal": "reconcile_payment", "eventIdPointer": "/id", "resourcePointer": "/data/object/id", "requiresInspection": true}
      ],
