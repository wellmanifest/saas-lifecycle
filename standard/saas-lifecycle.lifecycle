# Source: https://github.com/wellmanifest/lifecycle
# Revision: 1ea2a90bd5b90a768ad2b36a9c1c330523bc80b4
# Compatibility projection; domain conformance remains authoritative.

LIFECYCLE saas-tenant VERSION 1
DESCRIPTION "Commercial tenant state with verified billing and provisioning boundaries"
STATE REQUESTED INITIAL
STATES [MEMBERSHIP_VERIFIED, TRIAL_ACTIVE, TRIAL_EXPIRING, PAYMENT_PENDING, PAID_PENDING_PROVISIONING, ACTIVE, PLAN_CHANGE_PENDING, SUSPENDED]
STATES [CANCELLED, EXPIRED, FAILED] TERMINAL
EVENTS [SIGNUP, START_TRIAL, TRIAL_NOTICE, SELECT_PLAN, CONFIRM_SUBSCRIPTION, PROVISION, PURCHASE_ADDON, REQUEST_PLAN_CHANGE, ACTIVATE_PLAN_CHANGE, SUSPEND, RESUME, CANCEL, EXPIRE, FAIL]
EVIDENCES [MEMBERSHIP_EVIDENCE, TRIAL_POLICY, NOTICE_EVIDENCE, PLAN_SELECTION, VERIFIED_BILLING, VERIFIED_DEPLOYMENT, VERIFIED_USAGE_GRANT, PLAN_CHANGE_EVIDENCE, SUSPENSION_EVIDENCE, CANCELLATION_EVIDENCE, EXPIRATION_EVIDENCE, FAILURE_EVIDENCE]
TRANSITION REQUESTED -> MEMBERSHIP_VERIFIED ON SIGNUP REQUIRES MEMBERSHIP_EVIDENCE
TRANSITION MEMBERSHIP_VERIFIED -> TRIAL_ACTIVE ON START_TRIAL REQUIRES TRIAL_POLICY
TRANSITION [MEMBERSHIP_VERIFIED, TRIAL_EXPIRING] -> PAYMENT_PENDING ON SELECT_PLAN REQUIRES PLAN_SELECTION
TRANSITION TRIAL_ACTIVE -> TRIAL_EXPIRING ON TRIAL_NOTICE REQUIRES NOTICE_EVIDENCE
TRANSITION PAYMENT_PENDING -> PAID_PENDING_PROVISIONING ON CONFIRM_SUBSCRIPTION REQUIRES VERIFIED_BILLING
TRANSITION PAID_PENDING_PROVISIONING -> ACTIVE ON PROVISION REQUIRES VERIFIED_DEPLOYMENT
TRANSITION ACTIVE -> ACTIVE ON PURCHASE_ADDON REQUIRES VERIFIED_USAGE_GRANT
TRANSITION ACTIVE -> PLAN_CHANGE_PENDING ON REQUEST_PLAN_CHANGE REQUIRES PLAN_CHANGE_EVIDENCE
TRANSITION PLAN_CHANGE_PENDING -> ACTIVE ON ACTIVATE_PLAN_CHANGE REQUIRES VERIFIED_DEPLOYMENT
TRANSITION ACTIVE -> SUSPENDED ON SUSPEND REQUIRES SUSPENSION_EVIDENCE
TRANSITION SUSPENDED -> ACTIVE ON RESUME REQUIRES VERIFIED_BILLING
TRANSITION [TRIAL_ACTIVE, ACTIVE] -> CANCELLED ON CANCEL REQUIRES CANCELLATION_EVIDENCE
TRANSITION [TRIAL_EXPIRING, SUSPENDED] -> EXPIRED ON EXPIRE REQUIRES EXPIRATION_EVIDENCE
TRANSITION PAID_PENDING_PROVISIONING -> FAILED ON FAIL REQUIRES FAILURE_EVIDENCE
END
