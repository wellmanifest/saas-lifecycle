# Canonical SaaS lifecycle request v1. The accepted language is the
# intersection of this grammar and saas-lifecycle.schema.json. It cannot emit
# email, payment status, webhook payload/signature, raw tenant coordinates,
# credentials, deployment commands or an inline authority decision.
root ::= request
request ::= "{\"$schema\":\"https://wellmanifest.dev/schemas/saas-lifecycle/v1\",\"schema\":\"wellmanifest.saas-lifecycle-request/v1\",\"requestId\":" identifier ",\"operation\":" operation ",\"accountRef\":" account-ref ",\"tenantRef\":" tenant-ref ",\"planRef\":" plan-ref ",\"priceRef\":" price-ref ",\"billingRef\":" billing-ref ",\"intentRef\":" intent-ref ",\"grantRef\":" grant-ref ",\"planHash\":" sha256 "}"
operation ::= "\"inspect\"" | "\"signup\"" | "\"select_plan\"" | "\"start_trial\"" | "\"confirm_subscription\"" | "\"purchase_addon\"" | "\"request_plan_change\"" | "\"cancel\""
identifier ::= "\"" lower id-tail "\""
account-ref ::= "\"account://" authority "/" identifier-body "\""
tenant-ref ::= "\"tenant://" authority "/" identifier-body "\""
plan-ref ::= "\"plan://" authority "/" identifier-body "/v" positive-digits "\""
price-ref ::= "\"price://" authority "/" path "/v" positive-digits "\""
billing-ref ::= "\"billing://" authority "/" path "\""
intent-ref ::= "\"intent://" authority "/" path "\""
grant-ref ::= "\"grant://" authority "/" path "\""
sha256 ::= "\"" hex64 "\""
authority ::= lower authority-tail
authority-tail ::= ([a-z0-9.-])*
path ::= path-char (path-char)*
path-char ::= [A-Za-z0-9._:/-]
identifier-body ::= lower id-tail
id-tail ::= ([a-z0-9._:-])*
positive-digits ::= [1-9] ([0-9])*
hex64 ::= hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex hex
hex ::= [a-f0-9]
lower ::= [a-z]
